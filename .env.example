# Copy to .env for a local run outside Docker. Every value here is also the
# built-in default, so an empty .env works for development.

NODE_ENV=development
PORT=4000

# Origins allowed to call the API. The Next dev server is on 3000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres. Inside Docker Compose the host is `postgres`, not `localhost`.
DATABASE_URL=postgres://eventsmedia:eventsmedia@localhost:5432/eventsmedia
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Token signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The API refuses to start with NODE_ENV=production if these are left as the
# development defaults.
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me
JWT_REFRESH_SECRET=dev-only-insecure-secret-change-me-refresh
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
REFRESH_TTL_REMEMBER_SECONDS=2592000

# One-time codes.
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_SECONDS=1800

# With no mail provider wired up, echo the code and the reset token in the
# response so the sign-in flow can be tested locally. Ignored in production.
EXPOSE_DEV_CODES=true

# Per-IP ceiling for the whole API; the auth routes are tighter still.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=30

# Turns the limiter into a pass-through. Only for re-running the API collection
# in postman/, which makes more calls in a minute than a real client would.
# Ignored when NODE_ENV=production.
RATE_LIMIT_DISABLED=false

# Set when running behind a reverse proxy so the client IP is read from
# X-Forwarded-For rather than the proxy's own address.
TRUST_PROXY=false
