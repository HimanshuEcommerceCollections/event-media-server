# Development image: runs the TypeScript directly under tsx with watch, so a
# source edit restarts the server without a rebuild. Compose bind-mounts ./src
# over this stage's copy.
FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src

EXPOSE 4000

# `npm run dev` would put npm between the signal and the process; calling tsx
# directly keeps SIGTERM going where it needs to.
CMD ["npx", "tsx", "watch", "src/index.ts"]
