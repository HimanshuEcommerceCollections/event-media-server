# Copy to .env for a local run outside Docker. Every value here is also the
# built-in default, so an empty .env works for development.

NODE_ENV=development
PORT=4000

# Origins allowed to call the API. The Next dev server is on 3000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres. Inside Docker Compose the host is `postgres`, not `localhost`.
DATABASE_URL=postgres://eventsmedia:eventsmedia@localhost:5432/eventsmedia
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Token signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The API refuses to start with NODE_ENV=production if these are left as the
# development defaults.
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me
JWT_REFRESH_SECRET=dev-only-insecure-secret-change-me-refresh
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
REFRESH_TTL_REMEMBER_SECONDS=2592000

# One-time codes.
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_SECONDS=1800

# With no SMTP_HOST set, the mailer is a no-op: the code and the reset token
# come back in the response and are logged, so the flow is testable without a
# provider. Ignored in production, which refuses to boot without SMTP.
EXPOSE_DEV_CODES=true

# Mail. Leave SMTP_HOST empty for a local run. With Gmail, SMTP_PASSWORD is a
# 16-character app password, not the account password, and the account needs
# 2-Step Verification turned on.
#   Port 587 -> SMTP_SECURE=false (STARTTLS). Port 465 -> SMTP_SECURE=true.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM defaults to SMTP_USER. Gmail rewrites a From it does not own, so
# it has to be the authenticated address or a verified "send mail as" alias.
# MAIL_FROM="Events & Media <you@example.com>"
# MAIL_BRAND=Events & Media
# SMTP_TIMEOUT_MS=10000

# Base of the reset link mailed by /auth/password/forgot: the frontend origin,
# not the API's. PASSWORD_RESET_PATH must be a real page that reads ?token=.
APP_URL=http://localhost:3000
PASSWORD_RESET_PATH=/reset-password

# Per-IP ceiling for the whole API; the auth routes are tighter still.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=30

# Turns the limiter into a pass-through. Only for re-running the API collection
# in postman/, which makes more calls in a minute than a real client would.
# Ignored when NODE_ENV=production.
RATE_LIMIT_DISABLED=false

# Set when running behind a reverse proxy so the client IP is read from
# X-Forwarded-For rather than the proxy's own address.
TRUST_PROXY=false
